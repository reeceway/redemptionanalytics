<script>
  window.addEventListener('load', () => {
    document.getElementById('heroH')?.classList.add('go');
    document.getElementById('browserMock')?.classList.add('go');
    // Hero ownership counter
    let v = 0;
    const el = document.getElementById('hp');
    if (el) {
      const t = setInterval(() => {
        v = Math.min(v + 2, 100);
        el.textContent = String(v);
        if (v >= 100) clearInterval(t);
      }, 14);
    }
  });

  // Stat counters
  const co = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      const target = Number(el.dataset.to);
      let v = 0;
      const step = target / 55;
      const t = setInterval(() => {
        v = Math.min(v + step, target);
        el.textContent = String(Math.floor(v));
        if (v >= target) clearInterval(t);
      }, 16);
      co.unobserve(el);
    });
  }, { threshold: 0.5 });

  const s1 = document.getElementById('s1');
  const s2 = document.getElementById('s2');
  if (s1) { s1.dataset.to = '100'; co.observe(s1); }
  if (s2) { s2.dataset.to = '6'; co.observe(s2); }
</script>
